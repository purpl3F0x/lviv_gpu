digraph thread_pipeline {
    rankdir=LR;
    splines=true;
    ranksep=1.0;
    nodesep=0.35;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    fp_mul_1 [label="*", shape=circle, group="c0", tooltip="fp_mul_1 / fp_mul_1"];
    fp_mul_2 [label="*", shape=circle, group="c0", tooltip="fp_mul_2 / fp_mul_2"];
    fp_mul_3 [label="*", shape=circle, group="c0", tooltip="fp_mul_3 / fp_mul_3"];
    fp_mul_10 [label="*", shape=circle, group="c5", tooltip="fp_mul_10 / fp_mul_4"];
