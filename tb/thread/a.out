// -----------------------------------------------------------------------------
// Floating-Point Unit Wrappers
// Copyright (c) 2026 Stavros Avramidis
//
// Provides Verilator simulation equivalents and bindings for Xilinx Floating-Point IPs.
// IPs are non-blocking with aclk, arst (active high), and aclken.
// -----------------------------------------------------------------------------

`timescale 1ns / 1ns







  








  
  



// ============================================================================
// Floating-Point Adder
// ============================================================================
module fp_add #(
    parameter int LATENCY = 11  // Default latency for Xilinx FP Add
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        valid_in,
    input  logic [31:0] a,
    input  logic [31:0] b,
    output logic [31:0] result
);


  shortreal a_real, b_real, res_real;
  logic [31:0] res_bits;
  logic [31:0] pipeline [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign b_real   = $bitstoshortreal(b);
  assign res_real = a_real + b_real;
  assign res_bits = $shortrealtobits(res_real);

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i] <= 32'b0;
      end
    end else if (aclken) begin
      pipeline[0] <= res_bits;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i] <= pipeline[i-1];
      end
    end
  end

  assign result = pipeline[LATENCY-1];

















endmodule

// ============================================================================
// Floating-Point Subtractor
// ============================================================================
module fp_sub #(
    parameter int LATENCY = 11  // Default latency for Xilinx FP Sub
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        valid_in,
    input  logic [31:0] a,
    input  logic [31:0] b,
    output logic [31:0] result
);


  shortreal a_real, b_real, res_real;
  logic [31:0] res_bits;
  logic [31:0] pipeline [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign b_real   = $bitstoshortreal(b);
  assign res_real = a_real - b_real;
  assign res_bits = $shortrealtobits(res_real);

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i] <= 32'b0;
      end
    end else if (aclken) begin
      pipeline[0] <= res_bits;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i] <= pipeline[i-1];
      end
    end
  end

  assign result = pipeline[LATENCY-1];
















endmodule

// ============================================================================
// Floating-Point Multiplier
// ============================================================================
module fp_mul #(
    parameter int LATENCY = 8  // Default latency for Xilinx FP Mul
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        valid_in,
    input  logic [31:0] a,
    input  logic [31:0] b,
    output logic [31:0] result
);


  shortreal a_real, b_real, res_real;
  logic [31:0] res_bits;
  logic [31:0] pipeline [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign b_real   = $bitstoshortreal(b);
  assign res_real = a_real * b_real;
  assign res_bits = $shortrealtobits(res_real);

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i] <= 32'b0;
      end
    end else if (aclken) begin
      pipeline[0] <= res_bits;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i] <= pipeline[i-1];
      end
    end
  end

  assign result = pipeline[LATENCY-1];
















endmodule

// ============================================================================
// Floating-Point Fused Multiply-Add: (a * b) + c
// ============================================================================
module fp_fma #(
    parameter int LATENCY = 19  // Default latency for Xilinx FP FMA
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        valid_in,
    input  logic [31:0] a,
    input  logic [31:0] b,
    input  logic [31:0] c,
    output logic [31:0] result
);


  shortreal a_real, b_real, c_real, res_real;
  logic [31:0] res_bits;
  logic [31:0] pipeline [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign b_real   = $bitstoshortreal(b);
  assign c_real   = $bitstoshortreal(c);
  assign res_real = (a_real * b_real) + c_real;
  assign res_bits = $shortrealtobits(res_real);

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i] <= 32'b0;
      end
    end else if (aclken) begin
      pipeline[0] <= res_bits;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i] <= pipeline[i-1];
      end
    end
  end

  assign result = pipeline[LATENCY-1];


















endmodule

// ============================================================================
// Floating-Point Reciprocal (1/x)
// ============================================================================
module fp_recip #(
    parameter int LATENCY = 29  // Default latency for Xilinx FP Recip
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        valid_in,
    input  logic [31:0] a,
    output logic [31:0] result
);


  shortreal a_real, res_real;
  logic [31:0] res_bits;
  logic [31:0] pipeline [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign res_real = 1.0 / a_real;
  assign res_bits = $shortrealtobits(res_real);

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i] <= 32'b0;
      end
    end else if (aclken) begin
      pipeline[0] <= res_bits;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i] <= pipeline[i-1];
      end
    end
  end

  assign result = pipeline[LATENCY-1];















endmodule

// ============================================================================
// Floating-Point Adder/Subtractor
// ============================================================================
module fp_add_sub #(
    parameter int LATENCY = 11
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        op_sub, // 0 for add, 1 for sub
    input  logic        valid_in,
    input  logic [31:0] a,
    input  logic [31:0] b,
    output logic        valid_out,
    output logic [31:0] result
);


  shortreal a_real, b_real, res_real;
  logic [31:0] res_bits;
  logic [31:0] pipeline [LATENCY];
  logic        valid_pipe [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign b_real   = $bitstoshortreal(b);
  assign res_real = op_sub ? (a_real - b_real) : (a_real + b_real);
  assign res_bits = $shortrealtobits(res_real);

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i]   <= 32'b0;
        valid_pipe[i] <= 1'b0;
      end
    end else if (aclken) begin
      pipeline[0]   <= res_bits;
      valid_pipe[0] <= valid_in;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i]   <= pipeline[i-1];
        valid_pipe[i] <= valid_pipe[i-1];
      end
    end
  end

  assign result    = pipeline[LATENCY-1];
  assign valid_out = valid_pipe[LATENCY-1];


















endmodule

// ============================================================================
// Floating-Point to 16-bit Signed Integer (2-cycle latency)
// ============================================================================
module fp32_to_int16 #(
    parameter int LATENCY = 2
) (
    input  logic        aclk,
    input  logic        aresetn,
    input  logic        aclken,
    input  logic        valid_in,
    input  logic [31:0] a,
    output logic [15:0] result
);


  shortreal a_real;
  logic [15:0] res_bits;
  logic [15:0] pipeline [LATENCY];

  assign a_real   = $bitstoshortreal(a);
  assign res_bits = 16'(int'(a_real));

  always_ff @(posedge aclk) begin
    if (!aresetn) begin
      for (int i = 0; i < LATENCY; i++) begin
        pipeline[i] <= 16'b0;
      end
    end else if (aclken) begin
      pipeline[0] <= res_bits;
      for (int i = 1; i < LATENCY; i++) begin
        pipeline[i] <= pipeline[i-1];
      end
    end
  end

  assign result = pipeline[LATENCY-1];














endmodule
